<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Back camera full screen -->
    <TextureView
        android:id="@+id/backPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Front camera PIP -->
    <FrameLayout
        android:id="@+id/frontContainer"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="#FF000000"
        android:elevation="8dp">

        <TextureView
            android:id="@+id/frontPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- border -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/grid_lines"
            android:alpha="0.3" />
    </FrameLayout>

    <!-- Controls bar at bottom -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingBottom="24dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Gallery / empty space left -->
            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="32dp" />

            <!-- Shutter button -->
            <FrameLayout
                android:id="@+id/shutterButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shutter_outer" />

                <View
                    android:id="@+id/shutterInner"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_inner_photo" />
            </FrameLayout>

            <!-- Switch camera / empty right -->
            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="32dp" />
        </LinearLayout>

        <!-- Mode indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginBottom="80dp"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/modePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="PHOTO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#33FFFFFF" />

            <TextView
                android:id="@+id/modeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="VIDEO"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
